# Copie para .env.local (que é ignorado pelo Git). NUNCA commite valores reais.

# Projeto Supabase usado pelo app. Somente a chave PÚBLICA "anon" (ou "publishable").
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon

# ⚠️ PROIBIDO neste arquivo e em qualquer variável NEXT_PUBLIC_*:
#    service_role / secret key do Supabase. Ela ignora o RLS e daria acesso total ao banco.
#    Se um dia for necessária (ex.: tarefa de servidor), use variável SEM prefixo NEXT_PUBLIC_,
#    apenas em Route Handlers/Server Actions e somente no ambiente da Vercel.

# --- Somente para os testes de isolamento (npm run test:rls) ---
# Use um projeto Supabase de TESTE/branch e contas FICTÍCIAS dedicadas. Nunca contas reais.
# RLS_CONFIRMA_AMBIENTE_DE_TESTE=sim
# RLS_SUPABASE_URL=
# RLS_SUPABASE_ANON_KEY=
# RLS_USER_A_EMAIL=
# RLS_USER_A_PASSWORD=
# RLS_USER_B_EMAIL=
# RLS_USER_B_PASSWORD=
# RLS_USER_C_EMAIL=
# RLS_USER_C_PASSWORD=
